{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mavo-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    { "name": "AUTH_IP_LIMITER", "namespace_id": "71001", "simple": { "limit": 30, "period": 60 } },
    { "name": "AUTH_ID_LIMITER", "namespace_id": "71002", "simple": { "limit": 5, "period": 60 } },
    { "name": "USER_ACTION_LIMITER", "namespace_id": "71003", "simple": { "limit": 30, "period": 60 } }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "618629c1266146b5b4f898761552d004"
    }
  ],
  "vars": {
    "APP_ENV": "preview",
    "AWS_ENDPOINT_URL_S3": "https://br-divine-shape-bi7a8pkw.storage.c-5.ap-southeast-1.aws.neon.tech",
    "AWS_REGION": "ap-southeast-1"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "previews": {
    "observability": {
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": false,
        "head_sampling_rate": 1,
        "persist": true
      },
      "issue_detection": {
        "enabled": false
      }
    }
  }
}
