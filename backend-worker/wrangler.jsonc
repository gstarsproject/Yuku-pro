{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "MAVO-pro",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "preview_urls": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d78dcb8064294c72bfe93c85a1bd2df4"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "previews": {
    "hyperdrive": [
      {
        "binding": "HYPERDRIVE",
        "id": "618629c1266146b5b4f898761552d004"
      }
    ],
    "vars": {
      "APP_ENV": "preview"
    }
  }
}
