{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yuku-api-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
