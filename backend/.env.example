DATABASE_URL="postgresql://yuku:yuku_local_only@localhost:5432/yuku?schema=public"
PORT=3000
API_PREFIX=api/v1
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_before_use

# One-time initial admin creation only; remove both variables after running npm run admin:bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_unique_password_at_least_12_chars

# Payment gateway (sandbox first)
PAYMENT_GATEWAY=midtrans
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=replace_me
MIDTRANS_CLIENT_KEY=replace_me
MIDTRANS_WEBHOOK_URL=http://localhost:3000/payments/webhook/midtrans
