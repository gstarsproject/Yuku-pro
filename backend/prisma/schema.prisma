generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
  SUPERADMIN
}
enum UserStatus {
  ACTIVE
  PENDING_SUSPENDED
  SUSPENDED
  DELETED
}
enum ProviderVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}
enum ServiceMode {
  ONLINE
  OFFLINE
  BOTH
}
enum PriceUnit {
  HOUR
  SESSION
  DAY
  FIXED
}
enum BookingStatus {
  PENDING_PROVIDER
  ACCEPTED
  REJECTED
  AWAITING_PAYMENT
  PAID
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
}
enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}
enum LedgerEntryType {
  CREDIT
  DEBIT
  REVERSAL
}
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String?    @unique
  phone          String?    @unique
  passwordHash   String
  role           UserRole   @default(CUSTOMER)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  profile        Profile?
  provider       ProviderProfile?
  customerBookings Booking[] @relation("CustomerBookings")
  providerBookings Booking[] @relation("ProviderBookings")
  reviews        Review[]   @relation("ReviewAuthor")
  documents      VerificationDocument[]
  messages       Message[]
  conversationParticipants ConversationParticipant[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent Notification[] @relation("NotificationActor")
  posts          Post[]
  postLikes      PostLike[]
  postComments   PostComment[]
  stories        Story[]
  mediaAssets    MediaAsset[]
  sessions       UserSession[]
  following      Follow[] @relation("UserFollowing")
  followers      Follow[] @relation("UserFollowers")
  blocksMade     UserBlock[] @relation("UserBlocksMade")
  blocksReceived UserBlock[] @relation("UserBlocksReceived")
  reportsSubmitted ContentReport[] @relation("ReportsSubmitted")
  reportsAgainst ContentReport[] @relation("ReportsAgainst")
  adminAuditLogs AdminAuditLog[]
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String
  avatarUrl   String?
  bio         String?  @db.VarChar(1000)
  city        String?
  province    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderProfile {
  id                 String @id @default(uuid()) @db.Uuid
  userId             String @unique @db.Uuid
  verificationStatus ProviderVerificationStatus @default(NOT_STARTED)
  headline           String?
  languages          String[] @default([])
  experienceYears    Int?
  averageRating      Decimal? @db.Decimal(3,2)
  reviewCount        Int @default(0)
  completedBookings  Int @default(0)
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)
  services           Service[]
  availabilities     Availability[]
}

model Category {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  slug      String @unique
  pillar    String
  parentId  String? @db.Uuid
  isActive  Boolean @default(true)
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  services  Service[]
  commissionRule CommissionRule?
}

model Service {
  id             String @id @default(uuid()) @db.Uuid
  providerId     String @db.Uuid
  categoryId     String @db.Uuid
  title          String
  description    String @db.VarChar(5000)
  mode           ServiceMode
  priceAmount    Int
  currency       String @default("IDR")
  priceUnit      PriceUnit
  durationMinutes Int?
  city           String?
  province       String?
  isPublished    Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  provider       ProviderProfile @relation(fields: [providerId], references: [id])
  category       Category @relation(fields: [categoryId], references: [id])
  bookings       Booking[]
  @@index([categoryId, isPublished])
  @@index([city, province])
}

model Availability {
  id          String @id @default(uuid()) @db.Uuid
  providerId  String @db.Uuid
  startsAt    DateTime
  endsAt      DateTime
  isBlocked   Boolean @default(false)
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@index([providerId, startsAt, endsAt])
}

model Booking {
  id               String @id @default(uuid()) @db.Uuid
  customerId       String @db.Uuid
  providerId       String @db.Uuid
  serviceId        String @db.Uuid
  status           BookingStatus @default(PENDING_PROVIDER)
  startsAt         DateTime
  endsAt           DateTime
  durationMinutes  Int
  attendeeCount    Int @default(1)
  serviceMode      ServiceMode
  currency         String @default("IDR")
  serviceAmount    Int
  platformFee      Int @default(0)
  travelFee        Int @default(0)
  totalAmount      Int
  customerNote     String? @db.VarChar(2000)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  customer         User @relation("CustomerBookings", fields: [customerId], references: [id])
  provider         User @relation("ProviderBookings", fields: [providerId], references: [id])
  service          Service @relation(fields: [serviceId], references: [id])
  payment          Payment?
  payout           ProviderPayout?
  review           Review?
  dispute          Dispute?
  @@index([customerId, createdAt])
  @@index([providerId, startsAt])
  @@index([status, startsAt])
}

model Payment {
  id                String @id @default(uuid()) @db.Uuid
  bookingId         String @unique @db.Uuid
  gateway           String
  gatewayReference  String? @unique
  amount            Int
  currency          String @default("IDR")
  status            PaymentStatus @default(CREATED)
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  booking           Booking @relation(fields: [bookingId], references: [id])
}

model LedgerEntry {
  id          String @id @default(uuid()) @db.Uuid
  accountRef  String
  bookingId   String? @db.Uuid
  entryType   LedgerEntryType
  amount      Int
  currency    String @default("IDR")
  description String
  idempotencyKey String? @unique
  createdAt   DateTime @default(now())
  @@index([accountRef, createdAt])
  @@index([bookingId])
}

model Review {
  id          String @id @default(uuid()) @db.Uuid
  bookingId   String @unique @db.Uuid
  authorId    String @db.Uuid
  rating      Int
  comment     String? @db.VarChar(2000)
  createdAt   DateTime @default(now())
  booking     Booking @relation(fields: [bookingId], references: [id])
  author      User @relation("ReviewAuthor", fields: [authorId], references: [id])
}

model VerificationDocument {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @db.Uuid
  documentType String
  storageKey   String
  status       DocumentStatus @default(PENDING)
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  user         User @relation(fields: [userId], references: [id])
}

model Conversation {
  id         String @id @default(uuid()) @db.Uuid
  bookingId  String? @db.Uuid
  directKey  String? @unique
  createdAt  DateTime @default(now())
  messages   Message[]
  participants ConversationParticipant[]
}

model Message {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  senderId       String @db.Uuid
  body           String @db.VarChar(5000)
  createdAt      DateTime @default(now())
  readAt         DateTime?
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User @relation(fields: [senderId], references: [id])
  @@index([conversationId, createdAt])
}


model ConversationParticipant {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  userId         String @db.Uuid
  joinedAt       DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
}

model Notification {
  id          String @id @default(uuid()) @db.Uuid
  recipientId String @db.Uuid
  actorId     String? @db.Uuid
  type        String
  entityId    String? @db.Uuid
  message     String @db.VarChar(500)
  createdAt   DateTime @default(now())
  readAt      DateTime?
  recipient   User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

model Dispute {
  id          String @id @default(uuid()) @db.Uuid
  bookingId   String @unique @db.Uuid
  openedById  String @db.Uuid
  reason      String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  booking     Booking @relation(fields: [bookingId], references: [id])
}


model CommissionRule {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @unique @db.Uuid
  rateBps     Int      // 1000 = 10.00%; never use floating point for money/rates
  minFee      Int      @default(0)
  maxFee      Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id])
}

model ProviderPayout {
  id              String   @id @default(uuid()) @db.Uuid
  bookingId       String   @unique @db.Uuid
  providerUserId  String   @db.Uuid
  grossAmount     Int
  platformFee     Int
  gatewayFee      Int      @default(0)
  netAmount       Int
  currency        String   @default("IDR")
  status          String   @default("PENDING_RELEASE") // PENDING_RELEASE, READY, PROCESSING, PAID, FAILED
  releasedAt      DateTime?
  paidAt          DateTime?
  gatewayRef      String?  @unique
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  booking         Booking  @relation(fields: [bookingId], references: [id])
  @@index([providerUserId, status, createdAt])
}

model PaymentWebhookEvent {
  id             String   @id @default(uuid()) @db.Uuid
  gateway        String
  eventKey       String   @unique
  gatewayOrderId String
  eventType      String
  payload        Json
  processedAt    DateTime?
  createdAt      DateTime @default(now())
  @@index([gatewayOrderId, createdAt])
}


model Post {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @db.Uuid
  content   String   @db.VarChar(2000)
  audience  String   @default("PUBLIC") // PUBLIC, FOLLOWERS, PRIVATE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  comments  PostComment[]
  media     MediaAsset[]
  reports   ContentReport[]
  locationName String? @db.VarChar(200)
  latitude Float?
  longitude Float?

  @@index([createdAt])
  @@index([authorId, createdAt])
}
model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())
  blocker   User     @relation("UserBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockedId, createdAt])
}

model ContentReport {
  id           String   @id @default(uuid()) @db.Uuid
  reporterId   String   @db.Uuid
  targetUserId String   @db.Uuid
  postId       String?  @db.Uuid
  reportType   String   @default("USER") @db.VarChar(20)
  reason       String   @db.VarChar(80)
  details      String?  @db.VarChar(1000)
  status       String   @default("OPEN") @db.VarChar(20)
  createdAt    DateTime @default(now())
  reporter     User     @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser   User     @relation("ReportsAgainst", fields: [targetUserId], references: [id], onDelete: Cascade)
  post         Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([targetUserId, createdAt])
  @@index([postId, createdAt])
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model Story {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  content   String   @db.VarChar(500)
  audience  String   @default("PUBLIC") // PUBLIC, FOLLOWERS
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     MediaAsset[]
  locationName String? @db.VarChar(200)
  latitude Float?
  longitude Float?
  @@index([expiresAt])
  @@index([userId, createdAt])
}


model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @db.Uuid
  postId       String?  @db.Uuid
  storyId      String?  @db.Uuid
  mediaType    String   // IMAGE or VIDEO
  objectKey    String   @unique
  contentType  String
  byteSize     BigInt
  durationMs   Int?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post         Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  story        Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  @@index([postId, sortOrder])
  @@index([storyId, sortOrder])
  @@index([ownerId, createdAt])
}


model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String   @db.VarChar(80)
  targetType  String   @db.VarChar(80)
  targetId    String?  @db.VarChar(100)
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}
